      "separate_caller": true,
      "sample_text": "Oxi authored relative drawing layers payload",
      "program": "' SPDX-License-Identifier: CC-BY-SA-4.0\nPrivate Function LayerVector(ByVal ws As Object) As String\n    Dim s As Object, o As Object, n As Object, result As String\n    result = \"Shapes#\"\n    For Each s In ws.Shapes\n        result = result & s.ID & \",\" & s.Name & \",\" & s.Type & \",\" & s.ZOrderPosition & \";\"\n    Next\n    result = result & \"OLE#\"\n    For Each o In ws.OLEObjects\n        Set s = o.ShapeRange\n        result = result & s.ID & \",\" & s.Name & \",\" & s.Type & \",\" & s.ZOrderPosition & \";\"\n    Next\n    result = result & \"Notes#\"\n    For Each n In ws.Comments\n        Set s = n.Shape\n        result = result & s.ID & \",\" & s.Name & \",\" & s.Type & \",\" & s.ZOrderPosition & \";\"\n    Next\n    LayerVector = result\nEnd Function\n\nPublic Function Probe(ByVal mode As Long) As String\n    Dim wb As Object, ws As Object, note As Object, added As Object\n    Dim rectangle As Object, target As Object, before As String, hot As String\n    Set wb = Workbooks.Open(\"C:\\work\\provider.xlsx\", 0, True)\n    Set ws = wb.Worksheets(1)\n    If mode \\ 8 = 1 Then Set rectangle = ws.Shapes.AddShape(1, 10, 10, 20, 20)\n    Set note = ws.Range(\"D2\").AddComment(\"relative layer note\")\n    If mode \\ 8 = 2 Then Set added = ws.OLEObjects.Add(Filename:=\"C:\\work\\sample.txt\", Link:=False, DisplayAsIcon:=True, Left:=10, Top:=10, Width:=40, Height:=20)\n    before = LayerVector(ws)\n    wb.SaveAs \"C:\\work\\mixed-source.xlsx\", 51\n    If (mode \\ 4) Mod 2 = 0 Then\n        Set target = ws.Shapes(\"Object 2\")\n    Else\n        Set target = ws.OLEObjects(\"Object 2\").ShapeRange\n    End If\n    target.ZOrder mode Mod 4\n    hot = LayerVector(ws)\n    wb.SaveAs \"C:\\work\\mixed-copy.xlsx\", 51\n    wb.Close False\n    Set wb = Workbooks.Open(\"C:\\work\\mixed-copy.xlsx\", 0, True)\n    Probe = before & \"@\" & hot & \"@\" & LayerVector(wb.Worksheets(1))\n    wb.Close False\nEnd Function\n",
