      "program": "' SPDX-License-Identifier: CC-BY-SA-4.0\nPrivate Function LayerVector(ByVal ws As Object) As String\n    Dim s As Object, o As Object, n As Object, result As String\n    result = \"Shapes#\"\n    For Each s In ws.Shapes\n        result = result & s.ID & \",\" & s.Name & \",\" & s.Type & \",\" & s.ZOrderPosition & \";\"\n    Next\n    result = result & \"OLE#\"\n    For Each o In ws.OLEObjects\n        Set s = o.ShapeRange\n        result = result & s.ID & \",\" & s.Name & \",\" & s.Type & \",\" & s.ZOrderPosition & \";\"\n    Next\n    result = result & \"Notes#\"\n    For Each n In ws.Comments\n        Set s = n.Shape\n        result = result & s.ID & \",\" & s.Name & \",\" & s.Type & \",\" & s.ZOrderPosition & \";\"\n    Next\n    LayerVector = result\nEnd Function\n\nPrivate Function SaveState(ByVal wb As Object) As String\n    SaveState = CStr(wb.Saved) & \",\" & CStr(wb.FullName = \"C:\\work\\mixed-source.xlsx\") & \",\" & CStr(wb.ReadOnly)\nEnd Function\n\nPublic Function Probe(ByVal mode As Long) As String\n    Dim wb As Object, ws As Object, note As Object, added As Object, rectangle As Object\n    Dim before As String, firstState As String, secondState As String, hot As String\n    Set wb = Workbooks.Open(\"C:\\work\\provider.xlsx\", 0, True)\n    Set ws = wb.Worksheets(1)\n    If mode \\ 3 = 1 Then Set rectangle = ws.Shapes.AddShape(1, 10, 10, 20, 20)\n    Set note = ws.Range(\"D2\").AddComment(\"repeated save note\")\n    If mode \\ 3 = 2 Then Set added = ws.OLEObjects.Add(Filename:=\"C:\\work\\sample.txt\", Link:=False, DisplayAsIcon:=True, Left:=10, Top:=10, Width:=40, Height:=20)\n    before = LayerVector(ws)\n    wb.SaveAs \"C:\\work\\mixed-source.xlsx\", 51\n    firstState = SaveState(wb)\n    Select Case mode Mod 3\n        Case 0: wb.SaveAs \"C:\\work\\mixed-copy.xlsx\", 51\n        Case 1: wb.SaveCopyAs \"C:\\work\\mixed-copy.xlsx\"\n        Case 2\n            wb.Save\n            wb.SaveCopyAs \"C:\\work\\mixed-copy.xlsx\"\n    End Select\n    secondState = SaveState(wb)\n    hot = LayerVector(ws)\n    wb.Close False\n    Set wb = Workbooks.Open(\"C:\\work\\mixed-copy.xlsx\", 0, True)\n    Probe = before & \"@\" & firstState & \"@\" & secondState & \"@\" & hot & \"@\" & LayerVector(wb.Worksheets(1))\n    wb.Close False\nEnd Function\n",
