      "id": "explicit_font9",
      "program": "' SPDX-License-Identifier: CC-BY-SA-4.0\nOption Explicit\nPublic Function Probe(ByVal mode As Long) As String\n    Dim source As Workbook, target As Workbook, cold As Workbook\n    Dim ws As Worksheet, copied As Worksheet, note As Object\n    Dim result As String\n    Set source = Workbooks.Open(\"C:\\work\\provider.xlsx\", 0, True)\n    Set ws = source.Worksheets(1)\n    If mode Mod 3 = 1 Then ws.OLEObjects(1).Delete\n    If mode Mod 3 = 2 Then\n        Set note = ws.Range(\"D3\").AddComment(\"deleted note\")\n        note.Delete\n    End If\n    ws.Range(\"D2\").AddComment \"copied note\"\n    result = Observe(ws)\n    source.SaveAs \"C:\\work\\mixed-source.xlsx\", 51\n    Set target = Workbooks.Add(-4167)\n    Select Case mode \\ 3\n        Case 0: target.Styles(\"Normal\").Font.Name = \"Aptos Narrow\"\n        Case 1: target.Styles(\"Normal\").Font.Name = \"游ゴシック\"\n        Case 2: target.Styles(\"Normal\").Font.Name = \"Arial\"\n    End Select\n    target.Styles(\"Normal\").Font.Size = 11\n    target.Worksheets(1).Range(\"A1\").AddComment \"destination note\"\n    ws.Copy After:=target.Worksheets(1)\n    Set copied = target.Worksheets(2)\n    result = result & \"@\" & Observe(copied)\n    target.SaveAs \"C:\\work\\mixed-copy.xlsx\", 51\n    target.Close False\n    source.Close False\n    Set cold = Workbooks.Open(\"C:\\work\\mixed-copy.xlsx\", 0, True)\n    Probe = result & \"@\" & Observe(cold.Worksheets(2))\n    cold.Close False\nEnd Function\nPrivate Function Observe(ByVal ws As Worksheet) As String\n    Dim i As Long, item As Object, result As String\n    result = CStr(ws.Parent.Styles(\"Normal\").Font.Name) & \"|\" & CStr(ws.Parent.Styles(\"Normal\").Font.Size) & \"#\"\n    For i = 1 To ws.OLEObjects.Count\n        Set item = ws.OLEObjects(i)\n        result = result & CStr(item.ShapeRange.ID) & \",\" & item.Name & \",\" & CStr(item.ShapeRange.Type) & \",\" & CStr(item.ShapeRange.ZOrderPosition) & \",\"\n        result = result & CStr(item.Left) & \",\" & CStr(item.Top) & \",\" & CStr(item.Width) & \",\" & CStr(item.Height) & \",\" & CStr(item.Placement) & \",\"\n        result = result & CStr(item.Visible) & \",\" & CStr(item.Locked) & \",\" & CStr(item.PrintObject) & \";\"\n    Next\n    result = result & \"#\"\n    For i = 1 To ws.Comments.Count\n        Set item = ws.Comments(i).Shape\n        result = result & CStr(item.ID) & \",\" & item.Name & \",\" & CStr(item.ZOrderPosition) & \";\"\n    Next\n    Observe = result\nEnd Function\n",
