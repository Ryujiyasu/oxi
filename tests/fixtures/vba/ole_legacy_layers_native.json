      "sample_text": "Oxi authored drawing layers payload",
      "program": "' SPDX-License-Identifier: CC-BY-SA-4.0\nPrivate Function LayerVector(ByVal ws As Object) As String\n    Dim s As Object, o As Object, n As Object, result As String\n    result = \"Shapes#\"\n    For Each s In ws.Shapes\n        result = result & s.ID & \",\" & s.Name & \",\" & s.Type & \",\" & s.ZOrderPosition & \";\"\n    Next\n    result = result & \"OLE#\"\n    For Each o In ws.OLEObjects\n        Set s = o.ShapeRange\n        result = result & s.ID & \",\" & s.Name & \",\" & s.Type & \",\" & s.ZOrderPosition & \";\"\n    Next\n    result = result & \"Notes#\"\n    For Each n In ws.Comments\n        Set s = n.Shape\n        result = result & s.ID & \",\" & s.Name & \",\" & s.Type & \",\" & s.ZOrderPosition & \";\"\n    Next\n    LayerVector = result\nEnd Function\n\nPublic Function Probe(ByVal mode As Long) As String\n    Dim wb As Object, ws As Object, n As Object, o As Object, r As Object\n    Dim before As String, hot As String\n    Set wb = Workbooks.Open(\"C:\\work\\provider.xlsx\")\n    Set ws = wb.Worksheets(1)\n    before = LayerVector(ws)\n    wb.SaveAs \"C:\\work\\mixed-source.xlsx\", 51\n    If mode = 2 Then Set o = ws.OLEObjects.Add(Filename:=\"C:\\work\\sample.txt\", Link:=False, DisplayAsIcon:=True, Left:=10, Top:=10, Width:=40, Height:=20)\n    If mode = 7 Then Set r = ws.Shapes.AddShape(1, 10, 10, 20, 20)\n    Set n = ws.Range(\"D2\").AddComment(\"layer note\")\n    If mode = 1 Then Set o = ws.OLEObjects.Add(Filename:=\"C:\\work\\sample.txt\", Link:=False, DisplayAsIcon:=True, Left:=10, Top:=10, Width:=40, Height:=20)\n    If mode = 3 Then ws.OLEObjects(1).BringToFront\n    If mode = 4 Then ws.OLEObjects(2).SendToBack\n    If mode = 5 Then n.Shape.ZOrder 0\n    If mode = 6 Then n.Shape.ZOrder 1\n    If mode = 8 Then\n        Set r = ws.Shapes.AddShape(1, 10, 10, 20, 20)\n        ws.OLEObjects(1).SendToBack\n    End If\n    hot = LayerVector(ws)\n    wb.SaveAs \"C:\\work\\mixed-copy.xlsx\", 51\n    wb.Close False\n    Set wb = Workbooks.Open(\"C:\\work\\mixed-copy.xlsx\")\n    Probe = before & \"@\" & hot & \"@\" & LayerVector(wb.Worksheets(1))\n    wb.Close False\nEnd Function\n",
