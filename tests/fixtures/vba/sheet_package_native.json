  "row_order_program": "Attribute VB_Name = \"RowOrderOracle\"\nPublic Function Probe(ByVal mode As Long, ByVal inputPath As String, ByVal outputPath As String) As Variant\n    Set target = Workbooks.Open(inputPath, 0, True)\n    Set s = target.Worksheets(1)\n    s.Name = \"Original\"\n    If mode = 3 Then\n        Set other = target.Worksheets.Add(Before:=s)\n    Else\n        Set other = target.Worksheets.Add(After:=s)\n    End If\n    other.Name = \"Other\"\n    If mode = 2 Then s.Move After:=other\n    s.Cells.Font.Size = target.Styles(\"Normal\").Font.Size\n    If mode = 1 Then s.Move After:=other\n    before = Array(s.StandardHeight, s.Rows(100).RowHeight, s.Index)\n    target.SaveCopyAs outputPath\n    Set b = Workbooks.Open(outputPath, 0, True)\n    Set cold = b.Worksheets(\"Original\")\n    Probe = Array(before, Array(cold.StandardHeight, cold.Rows(100).RowHeight, cold.Index))\n    b.Close False\n    target.Close False\nEnd Function",
