  "program": "Attribute VB_Name = \"PackageOracle\"\nPublic Function Probe(ByVal mode As Long, ByVal inputPath As String, ByVal outputPath As String) As Variant\n    Set b = Workbooks.Open(inputPath, 0, True)\n    Set s = b.Worksheets(1)\n    Select Case mode\n    Case 1\n        s.Name = \"Original\"\n    Case 2\n        Set other = b.Worksheets.Add(After:=s)\n    Case 3\n        s.Cells.Font.Size = b.Styles(\"Normal\").Font.Size\n    Case 4\n        s.Name = \"Original\"\n        Set other = b.Worksheets.Add(After:=s)\n        s.Cells.Font.Size = b.Styles(\"Normal\").Font.Size\n    Case 5\n        s.Name = s.Name\n    Case 6\n        On Error Resume Next\n        s.Name = \"Invalid/Name\"\n        On Error GoTo 0\n    Case 7\n        oldName = s.Name\n        s.Name = \"Temporary\"\n        s.Name = oldName\n    End Select\n    before = State(b)\n    b.SaveCopyAs outputPath\n    hot = State(b)\n    Set copied = Workbooks.Open(outputPath, 0, True)\n    cold = State(copied)\n    Probe = Array(before, hot, cold)\n    copied.Close False\n    b.Close False\nEnd Function\nPublic Function State(ByVal b As Object) As Variant\n    State = Array(b.Worksheets.Count, b.Worksheets(1).Name, b.Worksheets(b.Worksheets.Count).Name, b.Worksheets(1).StandardHeight, b.Worksheets(1).Rows(100).RowHeight, b.Styles(\"Normal\").Font.Size, b.Saved)\nEnd Function",
