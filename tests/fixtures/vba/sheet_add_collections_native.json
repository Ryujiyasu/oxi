 countValue = \"2.9\"\n    Case 25: countValue = \" 2 \"\n    Case 26: countValue = \"&H2\"\n    Case 27: countValue = \"1,000\"\n    Case 28: countValue = Array(2, 1)\n    Case 29: countValue = Array(Array(2))\n    Case 30: countValue = 0.99\n    End Select\n    On Error Resume Next\n    Select Case bindingKind\n    Case 0\n    If mode = 0 Then\n        Set added = sheetSet.Add(After:=anchor)\n    ElseIf mode = 13 Then\n        Set added = sheetSet.Add(Before:=anchor, After:=anchor)\n    Else\n        Set added = sheetSet.Add(After:=anchor, Count:=countValue)\n    End If\n    Case 1\n    If mode = 0 Then\n        Set added = typedSet.Add(After:=anchor)\n    ElseIf mode = 13 Then\n        Set added = typedSet.Add(Before:=anchor, After:=anchor)\n    Else\n        Set added = typedSet.Add(After:=anchor, Count:=countValue)\n    End If\n    Case 2\n    If mode = 0 Then\n        Call sheetSet.Add(After:=anchor)\n    ElseIf mode = 13 Then\n        Call sheetSet.Add(Before:=anchor, After:=anchor)\n    Else\n        Call sheetSet.Add(After:=anchor, Count:=countValue)\n    End If\n    Case 3\n    If mode = 0 Then\n        Call typedSet.Add(After:=anchor)\n    ElseIf mode = 13 Then\n        Call typedSet.Add(Before:=anchor, After:=anchor)\n    Else\n        Call typedSet.Add(After:=anchor, Count:=countValue)\n    End If\n    End Select\n    errorCode = Err.Number\n    errorText = Err.Description\n    errorSource = Err.Source\n    Err.Clear\n    On Error GoTo 0\n    For i = 1 To book.Sheets.Count\n        names = names & \"|\" & book.Sheets(i).Name\n    Next i\n    If Not added Is Nothing Then addedIndex = added.Index\n    Probe = Array(errorCode, errorText, errorSource, TypeName(added), added Is Nothing, book.Sheets.Count, VarType(book.Sheets.Count), book.Saved, VarType(book.Saved), names, book.ActiveSheet.Index, addedIndex, VarType(countValue))\n    book.Close False\nEnd Function\n","cases":[{"receiver":0,"mode":5,"binding":0,"expected":[1004,"Sheets \u30af\u30e9\u30b9\u306e