{
  "name": "oxi-office-viewer",
  "displayName": "Oxidocs — .docx / .xlsx / .pptx editor",
  "description": "Open, edit and save .docx, .xlsx and .pptx in VS Code, and watch Claude Code or any AI agent write them: the tab redraws each time the file changes on disk. Rendered by Oxidocs, a Rust + WebAssembly engine measured against Microsoft Office. Nothing is uploaded.",
  "version": "0.9.11",
  "publisher": "oxidocs",
  "license": "(MIT OR Apache-2.0) AND MPL-2.0 AND OFL-1.1",
  "icon": "icon.png",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#1F2328",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "docx",
    "xlsx",
    "pptx",
    "word",
    "excel",
    "powerpoint",
    "office",
    "editor",
    "viewer",
    "japanese",
    "ai",
    "agent",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/Ryujiyasu/oxi.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://gitlab.com/Ryujiyasu/oxi",
  "bugs": {
    "url": "https://gitlab.com/Ryujiyasu/oxi/-/issues"
  },
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "oxi.officeViewer",
        "displayName": "Oxidocs Office editor",
        "selector": [
          {
            "filenamePattern": "*.docx"
          },
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.pptx"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "oxidocs-docx",
        "aliases": [
          "Word document"
        ],
        "extensions": [
          ".docx"
        ],
        "icon": {
          "light": "./icons/docx-light.svg",
          "dark": "./icons/docx-dark.svg"
        }
      },
      {
        "id": "oxidocs-xlsx",
        "aliases": [
          "Excel workbook"
        ],
        "extensions": [
          ".xlsx"
        ],
        "icon": {
          "light": "./icons/xlsx-light.svg",
          "dark": "./icons/xlsx-dark.svg"
        }
      },
      {
        "id": "oxidocs-pptx",
        "aliases": [
          "PowerPoint presentation"
        ],
        "extensions": [
          ".pptx"
        ],
        "icon": {
          "light": "./icons/pptx-light.svg",
          "dark": "./icons/pptx-dark.svg"
        }
      }
    ],
    "commands": [
      {
        "command": "oxi.openWithDefaultEditor",
        "title": "Oxidocs: Reopen this file with VS Code's default editor"
      }
    ]
  },
  "scripts": {
    "sync-web": "node scripts/sync-web.js",
    "package": "npm run sync-web && vsce package"
  }
}
