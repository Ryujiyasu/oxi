{
  "name": "oxi-office-viewer",
  "displayName": "Oxi — .docx / .xlsx / .pptx editor",
  "description": "Open, edit and save .docx, .xlsx and .pptx files inside VS Code, rendered by the Oxi engine — a Rust + WebAssembly Office engine measured page by page against Microsoft Office itself. Nothing is uploaded.",
  "version": "0.9.4",
  "publisher": "oxidocs",
  "license": "MIT OR Apache-2.0",
  "icon": "icon.png",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#1F2328",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "docx",
    "xlsx",
    "pptx",
    "word",
    "excel",
    "powerpoint",
    "office",
    "editor",
    "viewer",
    "japanese"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/Ryujiyasu/oxi.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://gitlab.com/Ryujiyasu/oxi",
  "bugs": {
    "url": "https://gitlab.com/Ryujiyasu/oxi/-/issues"
  },
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "oxi.officeViewer",
        "displayName": "Oxi Office editor",
        "selector": [
          {
            "filenamePattern": "*.docx"
          },
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.pptx"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "oxi.openWithDefaultEditor",
        "title": "Oxi: Reopen this file with VS Code's default editor"
      }
    ]
  },
  "scripts": {
    "sync-web": "node scripts/sync-web.js",
    "package": "npm run sync-web && vsce package"
  }
}
