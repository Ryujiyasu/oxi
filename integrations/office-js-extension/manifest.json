{
  "manifest_version": 3,
  "name": "Oxi Office Add-ins",
  "version": "0.1.0",
  "description": "Runs Office add-ins inside the Oxi spreadsheet editor (office.js answered by Oxi's oxi-office.js) and lets the editor call XLL add-ins through the local oxi-xll-host.",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://appsforoffice.microsoft.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://oxi-dd65f4.gitlab.io/*",
        "https://ryujiyasu.gitlab.io/oxi/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "oxi-office.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
